# =============================================================================
# sauri - Variables de entorno para desarrollo local (Docker Compose)
# =============================================================================

# --- Base de datos (PostgreSQL) ---
DATABASE_URL=postgresql://sauri:sauri_dev@postgres:5432/sauri
POSTGRES_DB=sauri
POSTGRES_USER=sauri
POSTGRES_PASSWORD=sauri_dev

# --- Almacenamiento de objetos (MinIO / S3-compatible) ---
OBJECT_STORE_ENDPOINT=http://minio:9000
OBJECT_STORE_BUCKET=sauri-recordings
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# --- Broker de cola (RabbitMQ) ---
QUEUE_BROKER_URL=amqp://guest:guest@rabbitmq:5672/

# --- Motor ASR (transcripción) ---
# Valores válidos: "local" | "cloud"
ASR_PROVIDER=local
# URL del motor ASR local (faster-whisper)
ASR_LOCAL_URL=http://asr-engine:8001
# Credenciales del proveedor ASR en la nube (solo si ASR_PROVIDER=cloud)
ASR_CLOUD_API_KEY=
ASR_CLOUD_ENDPOINT=

# --- Autenticación (JWT) ---
JWT_SECRET=dev-secret-change-in-production

# --- Retención de datos ---
# Días de retención para grabaciones y transcripciones (Req. 6.2)
RETENTION_DAYS=90
