# =============================================================================
# sauri - Variables de entorno para desarrollo local (Docker Compose)
# =============================================================================

# --- Base de datos (PostgreSQL) ---
DATABASE_URL=postgresql://sauri:sauri_dev@postgres:5432/sauri
POSTGRES_DB=sauri
POSTGRES_USER=sauri
POSTGRES_PASSWORD=sauri_dev

# --- Almacenamiento de objetos (MinIO / S3-compatible) ---
OBJECT_STORE_ENDPOINT=http://minio:9000
OBJECT_STORE_BUCKET=sauri-recordings
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# --- Broker de cola (RabbitMQ) ---
QUEUE_BROKER_URL=amqp://guest:guest@rabbitmq:5672/

# --- Motor ASR (transcripción) ---
# Valores válidos: "local" | "cloud"
ASR_PROVIDER=local
# Engine endpoints on the host; host processes must implement Sauri's HTTP contracts.
# Native MLX/whisper.cpp and pyannote/MPS adapters are not provided by this repository.
ASR_LOCAL_URL=http://host.docker.internal:8001
DIARIZATION_LOCAL_URL=http://host.docker.internal:8002
# Credenciales del proveedor ASR en la nube (solo si ASR_PROVIDER=cloud)
ASR_CLOUD_API_KEY=
ASR_CLOUD_ENDPOINT=

# --- Autenticación (JWT) ---
JWT_SECRET=dev-secret-change-in-production

# --- Claves de cifrado de referencias de extractos de hablantes ---
# Inject these from a managed secret store in deployed environments; never commit real key material.
# Generate values with: python -c 'import secrets; print(secrets.token_urlsafe(32))'
# Keep old key IDs during rotation and set the active ID to the new key.
SPEAKER_EXCERPT_ACTIVE_KEY_ID=
SPEAKER_EXCERPT_KEYRING=
# Deshabilita autenticación para desarrollo local (extensión sin flujo de login aún)
# TODO(auth): eliminar cuando la extensión implemente el flujo de login
AUTH_DISABLED=true

# --- Retención de datos ---
# Días de retención para grabaciones y transcripciones (Req. 6.2)
RETENTION_DAYS=90
