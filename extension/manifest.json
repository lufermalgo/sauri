{
  "manifest_version": 3,
  "name": "sauri",
  "version": "0.2.0",
  "description": "Asistente de captura y transcripción de reuniones de Google Meet",
  "permissions": [
    "tabCapture",
    "offscreen",
    "storage",
    "tabs",
    "scripting",
    "activeTab",
    "notifications",
    "alarms",
    "sidePanel"
  ],
  "host_permissions": [
    "https://meet.google.com/*",
    "http://localhost:8000/*"
  ],
  "background": {
    "service_worker": "src/background.ts",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["https://meet.google.com/*"],
      "js": ["src/content.ts"]
    }
  ],
  "side_panel": {
    "default_path": "src/panel/index.html"
  },
  "options_page": "src/options/index.html",
  "action": {
    "default_title": "sauri — Abrir panel"
  },
  "web_accessible_resources": [
    {
      "resources": ["src/detail/index.html"],
      "matches": ["<all_urls>"]
    }
  ]
}
