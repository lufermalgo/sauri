{
  "manifest_version": 3,
  "name": "sauri",
  "version": "0.7.0",
  "description": "Graba el audio y el video de cualquier pestaña del navegador y Sauri lo transcribe y lo resume.",
  "permissions": [
    "tabCapture",
    "offscreen",
    "storage",
    "tabs",
    "scripting",
    "activeTab",
    "notifications",
    "alarms",
    "sidePanel"
  ],
  "host_permissions": [
    "https://meet.google.com/*",
    "http://localhost:8000/*"
  ],
  "background": {
    "service_worker": "src/background.ts",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["https://meet.google.com/*"],
      "js": ["src/content.ts"]
    }
  ],
  "side_panel": {
    "default_path": "src/panel/index.html"
  },
  "options_page": "src/options/index.html",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Sauri — Abrir panel",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  }
}
