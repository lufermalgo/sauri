{
  "manifest_version": 3,
  "name": "sauri",
  "version": "0.1.0",
  "description": "Asistente de captura y transcripción de reuniones de Google Meet",
  "permissions": [
    "tabCapture",
    "offscreen",
    "storage",
    "tabs",
    "scripting",
    "activeTab",
    "notifications",
    "alarms"
  ],
  "host_permissions": [
    "https://meet.google.com/*",
    "http://localhost:8000/*"
  ],
  "background": {
    "service_worker": "src/background.ts",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["https://meet.google.com/*"],
      "js": ["src/content.ts"]
    }
  ],
  "action": {
    "default_popup": "src/panel/index.html",
    "default_title": "sauri — Grabar reunión"
  }
}
