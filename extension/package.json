{
  "name": "sauri-extension",
  "version": "0.9.2",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && cd dist && zip -q -r sauri-extension.zip . -x '*.zip' '.vite/*'",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "i18n:check": "vite-node --config scripts/node-scripts.config.ts scripts/i18n-check.ts",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "i18next": "26.7.2",
    "lucide": "1.66.0",
    "lucide-react": "1.66.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-i18next": "17.1.13"
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "^2.0.0-beta.25",
    "@playwright/test": "^1.45.0",
    "@testing-library/jest-dom": "^6.4.8",
    "@testing-library/react": "^16.0.0",
    "@types/chrome": "^0.0.268",
    "@types/node": "^20.19.43",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "fake-indexeddb": "^6.2.5",
    "fast-check": "^3.19.0",
    "jsdom": "^24.1.0",
    "typescript": "^5.5.0",
    "vite": "^6.4.5",
    "vite-node": "^3.2.4",
    "vitest": "^4.1.12"
  }
}
