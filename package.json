{
  "name": "sauri",
  "private": true,
  "workspaces": [
    "extension",
    "frontend",
    "desktop",
    "packages/*"
  ],
  "scripts": {
    "prepare": "git config core.hooksPath .githooks",
    "typecheck": "npm run typecheck --workspaces",
    "test": "npm run test --workspaces",
    "test:e2e": "npm run test:e2e --workspaces --if-present",
    "desktop:dev": "npm run dev -w desktop"
  },
  "engines": {
    "node": ">=20"
  }
}
