{
  "enabled": true,
  "name": "Verify Before Writing Code",
  "description": "Before writing code, forces the agent to inspect existing project conventions and avoid inventing paths, imports, APIs, scripts, or integration points.",
  "version": "1",
  "when": {
    "type": "preToolUse",
    "toolTypes": [
      "write"
    ]
  },
  "then": {
    "type": "askAgent",
    "prompt": "BEFORE WRITING CODE: verify the existing project structure and conventions first. Do not invent file paths, imports, package APIs, scripts, components, functions, configuration names, route names, environment variables, or integration points. If creating a new file, check whether the project uses exports, registries, route definitions, dependency wiring, module indexes, configuration manifests, or documentation that must also be updated. Match the existing project style instead of introducing a new pattern. If the project structure is unclear, inspect nearby files before writing. If this is documentation-only content, proceed normally."
  },
  "shortName": "verify-before-write"
}