{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/block-main-git.sh",
            "if": "Bash(git *)"
          }
        ]
      }
    ]
  },
  "worktree": {
    "symlinkDirectories": [
      "node_modules",
      "extension/node_modules",
      "frontend/node_modules",
      "backend/.venv"
    ],
    "baseRef": "fresh"
  }
}
